{
  "name": "express-server-v2",
  "version": "2.0.0-alpha.1",
  "description": "Express.js server with Bloom Auth V2",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "test": "vitest",
    "db:reset": "node scripts/reset-db.js"
  },
  "dependencies": {
    "@bloom/adapters-v2": "workspace:*",
    "@bloom/core-v2": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}
