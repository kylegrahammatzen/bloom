{
  "name": "express-server",
  "version": "2.0.0-alpha.1",
  "description": "Express.js server with Bloom Auth",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "test": "bun test",
    "db:reset": "bun scripts/reset-db.js"
  },
  "dependencies": {
    "@bloom/adapters": "workspace:*",
    "@bloom/core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
