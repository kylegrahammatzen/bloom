{
  "name": "bloom",
  "version": "2.0.0",
  "description": "Bloom is an open-source project to show how authentication really works",
  "author": "Kyle Graham Matzen <kgrahammatzen@gmail.com>",
  "private": true,
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:express": "bun run --cwd apps/express-server dev",
    "dev:bun": "bun run --cwd apps/bun-server dev",
    "dev:elysia": "bun run --cwd apps/elysia-server dev",
    "build": "turbo build",
    "test": "turbo test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "turbo": "^2.3.5",
    "typescript": "^5.9.3"
  }
}
