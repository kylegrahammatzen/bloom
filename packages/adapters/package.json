{
  "name": "@bloom/adapters",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "Framework adapters for Bloom Auth",
  "license": "AGPL-3.0",
  "author": "Kyle Graham Matzen <kylegrahammatzen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylegrahammatzen/bloom.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/kylegrahammatzen/bloom#readme",
  "bugs": {
    "url": "https://github.com/kylegrahammatzen/bloom/issues"
  },
  "keywords": [
    "auth",
    "express",
    "nextjs",
    "typescript",
    "bloom"
  ],
  "files": [
    "dist"
  ],
