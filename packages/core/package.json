{
  "name": "@bloom/core",
  "version": "2.0.0-alpha.1",
  "type": "module",
  "description": "Bloom Core - Framework-agnostic authentication with Zod v4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle/index.d.ts",
      "default": "./dist/adapters/drizzle/index.js"
    },
    "./adapters/kysely": {
      "types": "./dist/adapters/kysely/index.d.ts",
      "default": "./dist/adapters/kysely/index.js"
    },
    "./adapters/mongodb": {
      "types": "./dist/adapters/mongodb/index.d.ts",
      "default": "./dist/adapters/mongodb/index.js"
    },
    "./adapters/prisma": {
      "types": "./dist/adapters/prisma/index.d.ts",
      "default": "./dist/adapters/prisma/index.js"
    }
  },
  "license": "AGPL-3.0",
  "author": "Kyle Graham Matzen <kylegrahammatzen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylegrahammatzen/bloom.git",
    "directory": "packages/core"
  },
  "keywords": [
    "auth",
    "authentication",
    "session",
    "typescript",
    "framework-agnostic",
    "zod"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "test": "bun test"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "argon2": "^0.31.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@prisma/client": "6.3.0",
    "@sveltejs/kit": "2.46.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.18.8",
    "astro": "5.14.1",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.3",
    "elysia": "^1.4.9",
    "fastify": "^5.6.1",
    "h3": "^1.13.0",
    "hono": "4.9.10",
    "kysely": "0.28.1",
    "mongodb": "6.12.0",
    "next": "15.5.4",
    "redis": "^4.7.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.3"
  }
}
